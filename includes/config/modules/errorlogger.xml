<?xml version="1.0" encoding="UTF-8"?>
<errorlogger>
    <enabled>true</enabled>
    <format>text</format>
    <timestamp_format>Y-m-d H:i:s</timestamp_format>
    <include_session>true</include_session>
    <include_request>true</include_request>

    <exclude_keys>
        <key>password</key>
        <key>token</key>
        <key>auth</key>
    </exclude_keys>

    <log_cleanup>
        <enabled>true</enabled>
        <delete_after_days>30</delete_after_days>
    </log_cleanup>

    <log_types>
        <type enabled="true">PHP</type>
        <type enabled="true">DATABASE</type>
        <type enabled="true">ADMIN_PANEL</type>
    </log_types>

    <access_control>
        <allowed_ips>
            <ip>127.0.0.1</ip>
            <ip>::1</ip>
        </allowed_ips>
    </access_control>

    <notifications>
        <email_enabled>false</email_enabled>
        <email_to>admin@tuservidor.com</email_to>
    </notifications>
</errorlogger>
