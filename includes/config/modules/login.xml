<?xml version="1.0" encoding="ISO-8859-1"?>
<settings>
	<!-- Módulo login -->
	<active>1</active>

	<!-- Control de sesión -->
	<enable_session_timeout>1</enable_session_timeout>
	<session_timeout>3600</session_timeout>

	<!-- Seguridad: intentos fallidos -->
	<enable_failed_login_security>1</enable_failed_login_security>
	<max_login_attempts>5</max_login_attempts>
	<failed_login_timeout>15</failed_login_timeout>
	<lockout_duration>30</lockout_duration>

	<!-- Seguridad: acumulación de bloqueos -->
	<enable_accumulated_blocking>1</enable_accumulated_blocking>
	<max_temp_blocks_before_permanent>3</max_temp_blocks_before_permanent>

	<!-- Seguridad: bloqueo permanente -->
	<enable_permanent_blocking>1</enable_permanent_blocking>
	<permanent_block_after_bans>3</permanent_block_after_bans>

	<!-- Seguridad: estados de cuenta -->
	<user_status_active>1</user_status_active>
	<user_status_temp_block>2</user_status_temp_block>
	<user_status_perm_block>3</user_status_perm_block>

	<!-- Seguridad extendida: IP tras primer baneo -->
	<extended_block_ip_security>1</extended_block_ip_security>
	<extended_block_trigger_ban_count>1</extended_block_trigger_ban_count>
	<extended_block_max_failures_after_ban>3</extended_block_max_failures_after_ban>
	<extended_block_time_window>1440</extended_block_time_window> <!-- en minutos (24 horas) -->

	<!-- Funciones adicionales -->
	<remember_me_enabled>0</remember_me_enabled>
	<enable_2fa>0</enable_2fa>
	<password_min_length>8</password_min_length>
	<notify_on_failed_login>1</notify_on_failed_login>

	<!-- Seguridad: horario permitido de login -->
	<enable_login_hours>0</enable_login_hours>
	<allowed_login_hours>07:00-00:00</allowed_login_hours>
	
	<!-- Seguridad: reinicio automático de intentos fallidos -->
	<enable_failed_reset_after_24h>1</enable_failed_reset_after_24h>
</settings>